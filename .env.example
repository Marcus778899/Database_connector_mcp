# Copy to `.env`. That file is gitignored; this one is the thing to edit and
# commit when a variable is added.
#
# docker compose reads `.env` twice, and the two uses are worth telling apart:
#
#   * to fill in ${...} in docker-compose.yml — this file configures the shape
#     of the deployment;
#   * as the server's `env_file` — this is how <REF>_* reach the connector.
#
# A service's own `environment:` block wins over `env_file`, so anything
# docker-compose.yml sets explicitly (the transport, the ports, the paths under
# /data) cannot be overridden from here.
#
# Nothing in this file is a build argument. A build argument survives in
# `docker history`, which is not where a database password belongs.

# ---- which image ------------------------------------------------------------
# slim: sqlite, postgres, mysql/mariadb, mongodb, mcp
# full: the above plus mssql and datalake (unixODBC + Microsoft's driver)
MCP_TARGET=slim
MCP_TAG=slim

# ---- the source -------------------------------------------------------------
MCP_ENGINE=postgres
# Names the prefix of the connection variables below. Change both together.
MCP_CONNECTION_REF=shop

# ---- the connection ---------------------------------------------------------
# Suffixes: _HOST _PORT _USER _PASSWORD _DB/_DATABASE _URI _PATH _TOKEN.
# Which ones an engine wants is in the README's Configure section.
SHOP_HOST=db.internal
SHOP_PORT=5432
SHOP_USER=readonly
SHOP_PASSWORD=change-me
SHOP_DB=shop

# sqlite or datalake instead — a file-backed engine also needs its source
# mounted into the container; see the commented volume in docker-compose.yml.
# MCP_ENGINE=sqlite
# SHOP_PATH=/source/shop.db

# A whole URI replaces the parts above, and for some engines is the only way to
# say certain things — a unix socket for postgres, TrustServerCertificate for
# mssql.
# SHOP_URI=postgresql://readonly:change-me@db.internal:5432/shop

# ---- the agent being provisioned --------------------------------------------
# The name its public key takes, and the caller the audit trail records.
PROVISION_KID=agent
# Comma separated. These are exactly the tools the token can call, and exactly
# the ones the generated SKILL.md describes. Anything absent is refused.
PROVISION_SCOPES=list_containers,get_schema,get_sample,inventory_summary,inventory_search,inventory_columns,inventory_export
PROVISION_LIFETIME=30d
# 產出的 .mcp.json 預設把 token 寫成 ${...} 引用，由 client 展開。有些 client
# 不做展開，會把那串字面值當 token 送出去，server 則因為「格式不是 JWT」而拒絕
# —— 錯誤訊息講的是 token 形狀，不會提到變數，很容易誤判。遇到這種 client 就設
# 成 1，讓它直接寫入 token；.mcp.json 從此是一份憑證，記得別進版控。
# PROVISION_INLINE_TOKEN=1

# ---- how clients reach it ---------------------------------------------------
MCP_PUBLISHED_PORT=8000
# What goes into the generated .mcp.json. The container binds a port; it cannot
# know the host or scheme an agent will use to come back to it.
PROVISION_PUBLIC_URL=http://localhost:8000/mcp
MCP_SERVER_NAME=etl-agent-mcp
# Must be the same for the server and the tokens it accepts.
MCP_AUDIENCE=etl-agent-mcp
