# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# secret
.env
*.rsa.*
*.pem
*.jwt

# docker compose 的 provision 產物：私鑰、公鑰、以及當成憑證用的 token
private/
keys/
out/

# `docker compose cp` 把 inventory_export 的產物取出來的落點。是交付物不是原始碼，
# 而且內容是客戶資料庫的表名與欄位名——那份東西要不要進版控是客戶的決定，不是預設。
export/

# loggerhelper 在專案根目錄建立 log/<date>/
log/
